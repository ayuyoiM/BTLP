Configs: {
	BTitlesConfig: {
		DisplayName: Config

		Headers: {
			Scan: Scan
			Debug: Debug
		}

		EnableScan: {
			Label: Scan for new biomes
			Tooltip:
				'''
				Scan for ModBiome in each module that were not included in the original module, and add them to the detection list

				ON → Reload required to trigger the scan
				OFF → No reload needed, but registered biomes will still show up
				'''
		}

		EnableAutoStyling: {
			Label: Color Scheme
			Tooltip: Assign title colors to newly added biomes
		}

		EnableDebugLog: {
			Label: Debug logs
			Tooltip: Output the biome to client.log
		}
	}
}
