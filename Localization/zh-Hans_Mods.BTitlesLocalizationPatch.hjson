ExtraTitles.Terraria.Aether: 以太

Logs: {
	ScanEnabled: 已启用扫描新群系，开始扫描……
	CheckerNull: 未获取到群系检测函数列表，自动发现功能已禁用
	DetectionEx: 检测 [{0}] 模组的 [{1}] 群系时出错: {2}
	DictNull: 未获取到群系字典，自动发现功能已禁用
	DictStats: 群系字典共 {0} 项，检测函数共 {1} 个
	HookGetTitleNameFailed: 未找到 BiomeTitlesUI.GetActualTitleName 方法，Hook 注册失败
	IconLoadFailed: 加载群系 [{0}] 的图标时失败: {1}
	LoadReentry: 模组加载被重复调用，已跳过
	InstanceNull: 未获取到 BTitles 主模组实例，自动发现功能已禁用
	NewBiome: 新增群系: [{0}] → {1}
	ReflectCheckerNull: 反射获取检测函数字段失败
	ReflectDictNull: 反射获取群系字典字段失败
	ReflectInstanceNull: 反射获取主模组实例字段失败
	ScanningMod: 正在扫描模组 [{0}]，发现 {1} 个模组群系
	SkippedPlaceholder: 跳过占位群系: [{0}] → {1}（未重写检测方法）
	ScanSummary: 扫描完毕：{0} 新增，{1} 更新，{2} 跳过 | 字典 {3} 项，检测 {4} 个
}

Configs: {
	BTitlesConfig: {
		DisplayName: 配置

		Headers: {
			Scan: 扫描
			Debug: 调试
		}

		EnableScan: {
			Label: 扫描新群系
			Tooltip: 扫描各模组中未被原模组收录的模组群系（ModBiome）并添加到检测列表（需要重载一次来扫描新的群系）
		}

		EnableAutoStyling: {
			Label: 配色
			Tooltip: 为新增的群系分配标题颜色和图标（需要重载一次来配图标和颜色）
		}

		EnableDebugLog: {
			Label: 调试日志
			Tooltip: 输出群系到 client.log
		}
	}
}
