ExtraTitles.Terraria.Aether: 以太

Logs: {
	AddedCount: 自动注册了 {0} 个未收录群系
	ScanDisabled: 未启用扫描新群系，跳过群系注册
	CheckerField: Checker 字段={0}
	CheckerNull: BiomeCheckFunctions 为 null
	DetectionEx: 检测 {0}.{1} 时异常: {2}
	DictField: Dict 字段={0}
	DictNull: BiomeDictionary 为 null
	DictStats: 字典现有 {0} 个条目，{1} 个检测函数
	HookGetTitleNameFailed: 未找到 BiomeTitlesUI.GetActualTitleName
	IconLoadFailed: 加载群系 [{0}] 的图标失败: {1}
	InstanceField: Instance 字段={0}
	InstanceNull: Instance 为 null
	NewBiome: 新增: {0} → {1}
	PostSetupContentEnd: === PostSetupContent 结束 ===
	PostSetupContentStart: === PostSetupContent 开始 ===
	ReflectCheckerNull: 未反射到 BiomeCheckFunctions 字段
	ReflectDictNull: 未反射到 BiomeDictionary 字段
	ReflectInstanceNull: 未反射到 Instance 字段
	ScanningMod: 扫描模组 [{0}] 共 {1} 个 ModBiome
	UpdatedCount: 更新了 {0} 个群系的 DisplayName
}

Configs: {
	BTitlesConfig: {
		DisplayName: 配置

		Headers: {
			Scan: 扫描
			Debug: 调试
		}

		EnableScan: {
			Label: 扫描新群系
			Tooltip: 扫描各模组中未被原模组收录的模组群系（ModBiome）并添加到检测列表（需要重载一次来扫描新的群系）
		}

		EnableAutoStyling: {
			Label: 配色
			Tooltip: 为新增的群系分配标题颜色和图标（需要重载一次来配图标和颜色）
		}

		EnableDebugLog: {
			Label: 调试日志
			Tooltip: 输出群系到 client.log
		}
	}
}
